MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
PAYLOAD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional locally; use the same Blob store in both production projects.
BLOB_READ_WRITE_TOKEN=
EMAIL_FROM=bookings@nezcc.gov.in
EMAIL_TO_ADMIN=bookings-admin@nezcc.gov.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional absolute shared local upload directory; defaults to apps/web/public/media.
PAYLOAD_MEDIA_DIR=
